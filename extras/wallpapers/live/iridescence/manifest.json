    {"key": "contrast", "label": "Contraste", "type": "float", "min": 0.1, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "scale", "label": "Tamaño del patrón", "type": "float", "min": 0.2, "max": 4.0, "step": 0.05, "default": 1.0},
