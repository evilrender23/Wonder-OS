{
  "name": "Relámpago",
  "component": "Lightning",
  "description": "Rayos eléctricos que serpentean, se ramifican y parpadean.",
  "tags": ["energía", "brillante", "oscuro"],
  "params": [
    {"key": "color", "label": "Color", "type": "color", "default": "#4d6bff"},
    {"key": "background", "label": "Fondo", "type": "color", "default": "#0d1117"},
    {"key": "bolts", "label": "Rayos", "type": "int", "min": 1, "max": 4, "step": 1, "default": 1},
    {"key": "spread", "label": "Separación entre rayos", "type": "float", "min": 0.1, "max": 2.0, "step": 0.05, "default": 0.6},
    {"key": "branches", "label": "Ramificaciones", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.5},
    {"key": "x_offset", "label": "Desplazamiento lateral", "type": "float", "min": -1.5, "max": 1.5, "step": 0.05, "default": 0.0},
    {"key": "angle", "label": "Inclinación (grados)", "type": "float", "min": -90.0, "max": 90.0, "step": 1.0, "default": 0.0},
    {"key": "size", "label": "Escala del zigzag", "type": "float", "min": 0.2, "max": 4.0, "step": 0.05, "default": 1.0},
    {"key": "thickness", "label": "Grosor del núcleo", "type": "float", "min": 0.0, "max": 5.0, "step": 0.1, "default": 1.0},
    {"key": "glow", "label": "Alcance del resplandor", "type": "float", "min": 0.1, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "intensity", "label": "Intensidad", "type": "float", "min": 0.1, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "flicker", "label": "Parpadeo", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.6},
    {"key": "fade", "label": "Desvanecer bordes", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.0},
    {"key": "light_mode", "label": "Modo claro", "type": "bool", "default": false}
  ],
  "notes": "Un solo pase idéntico al original; sin curvatura hacia el cursor, rayos al hacer clic ni intro de descenso. En modo claro un fondo oscuro se sustituye por papel claro."
}
