{
  "name": "Haces",
  "component": "Beams",
  "description": "Franjas metálicas inclinadas cuyas ondulaciones atrapan destellos de luz.",
  "tags": ["luz", "metal", "oscuro"],
  "params": [
    {"key": "color", "label": "Color de la luz", "type": "color", "default": "#ffffff"},
    {"key": "beam_width", "label": "Ancho de cada haz (px)", "type": "float", "min": 20.0, "max": 500.0, "step": 1.0, "default": 140.0},
    {"key": "rotation", "label": "Ángulo (grados)", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 30.0},
    {"key": "wave_length", "label": "Longitud de las ondas (px)", "type": "float", "min": 40.0, "max": 800.0, "step": 1.0, "default": 233.0},
    {"key": "depth", "label": "Profundidad de las ondas", "type": "float", "min": 0.0, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "sharpness", "label": "Nitidez de los destellos", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.6},
    {"key": "twist", "label": "Giro de cada haz", "type": "float", "min": 0.0, "max": 2.0, "step": 0.05, "default": 0.0},
    {"key": "fill_light", "label": "Luz de relleno", "type": "float", "min": 0.0, "max": 1.5, "step": 0.05, "default": 0.3},
    {"key": "brightness", "label": "Intensidad de la luz", "type": "float", "min": 0.2, "max": 5.0, "step": 0.05, "default": 1.6},
    {"key": "glow", "label": "Resplandor", "type": "float", "min": 0.0, "max": 3.0, "step": 0.05, "default": 0.6},
    {"key": "grain", "label": "Grano", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.35},
    {"key": "variation", "label": "Variación", "type": "float", "min": 0.0, "max": 100.0, "step": 1.0, "default": 0.0},
    {"key": "fade", "label": "Difuminar bordes", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.0},
    {"key": "background", "label": "Fondo", "type": "color", "default": "#0d1117"},
    {"key": "light_mode", "label": "Modo claro", "type": "bool", "default": false, "description": "Destellos en tinta sobre papel; si el fondo es oscuro se usa blanco."}
  ],
  "notes": "El bloom de la cadena de mipmaps se aproxima con unas pocas muestras a lo largo del haz; sin luz que sigue al ratón, intro ni calidad de render."
}
