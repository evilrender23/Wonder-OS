{
  "name": "Hilos tejidos",
  "component": "WebThreads",
  "description": "Hilos de luz que se entrelazan y convergen en un punto brillante.",
  "tags": ["líneas", "neón", "ondas", "oscuro"],
  "params": [
    {"key": "color_count", "label": "Número de colores", "type": "int", "min": 1, "max": 4, "step": 1, "default": 2},
    {"key": "color1", "label": "Color 1 (primer hilo)", "type": "color", "default": "#5227ff"},
    {"key": "color2", "label": "Color 2", "type": "color", "default": "#ff9ffc"},
    {"key": "color3", "label": "Color 3", "type": "color", "default": "#b497cf"},
    {"key": "color4", "label": "Color 4", "type": "color", "default": "#ffffff"},
    {"key": "core_color", "label": "Color del núcleo", "type": "color", "default": "#ffffff"},
    {"key": "thread_count", "label": "Número de hilos", "type": "int", "min": 1, "max": 24, "step": 1, "default": 6},
    {"key": "frequency", "label": "Ondas a lo ancho", "type": "float", "min": 0.5, "max": 20.0, "step": 0.1, "default": 5.0},
    {"key": "spread", "label": "Apertura", "type": "float", "min": 0.0, "max": 0.6, "step": 0.01, "default": 0.18},
    {"key": "taper", "label": "Escalonado", "type": "float", "min": 0.0, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "position", "label": "Altura", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
    {"key": "pinch", "label": "Punto de unión", "type": "float", "min": 0.0, "max": 1.0, "step": 0.01, "default": 0.5},
    {"key": "nodes", "label": "Puntos de unión", "type": "int", "min": 1, "max": 6, "step": 1, "default": 1},
    {"key": "angle", "label": "Ángulo (grados)", "type": "float", "min": -180.0, "max": 180.0, "step": 1.0, "default": 0.0},
    {"key": "glow", "label": "Resplandor", "type": "float", "min": 0.005, "max": 0.1, "step": 0.001, "default": 0.02},
    {"key": "falloff", "label": "Caída del resplandor", "type": "float", "min": 0.3, "max": 1.5, "step": 0.05, "default": 0.6},
    {"key": "thickness", "label": "Grosor", "type": "float", "min": 0.1, "max": 4.0, "step": 0.05, "default": 1.1},
    {"key": "brightness", "label": "Brillo", "type": "float", "min": 0.1, "max": 2.0, "step": 0.05, "default": 0.6},
    {"key": "depth", "label": "Torsión 3D", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.0},
    {"key": "pulses", "label": "Pulsos de luz", "type": "float", "min": 0.0, "max": 2.0, "step": 0.05, "default": 0.0},
    {"key": "mirror", "label": "Espejo a cada lado", "type": "bool", "default": true},
    {"key": "shimmer", "label": "Vaivén irregular", "type": "bool", "default": false},
    {"key": "fade", "label": "Desvanecer extremos", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.0},
    {"key": "grain", "label": "Grano", "type": "float", "min": 0.0, "max": 0.3, "step": 0.01, "default": 0.05},
    {"key": "background", "label": "Fondo", "type": "color", "default": "#0d1117"},
    {"key": "light_mode", "label": "Modo claro", "type": "bool", "default": false},
    {"key": "paper", "label": "Fondo en modo claro", "type": "color", "default": "#f5f5f7"}
  ],
  "notes": "Sin foco del cursor, sin pulsos al hacer clic ni el trazado inicial de los hilos. La lista de colores del original se limita a cuatro paradas."
}
