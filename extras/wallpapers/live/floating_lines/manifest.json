{
  "name": "Líneas flotantes",
  "component": "FloatingLines",
  "description": "Haces de líneas luminosas que ondulan en tres olas con profundidad de campo.",
  "tags": ["líneas", "ondas", "brillo", "oscuro"],
  "extensions": ["GL_OES_standard_derivatives"],
  "params": [
    {"key": "color_1", "label": "Color 1 del degradado", "type": "color", "default": "#e945f5"},
    {"key": "color_2", "label": "Color 2 del degradado", "type": "color", "default": "#ffffff"},
    {"key": "color_3", "label": "Color 3 del degradado", "type": "color", "default": "#4cc2e9"},
    {"key": "colors", "label": "Colores usados", "type": "int", "min": 1, "max": 3, "step": 1, "default": 2},
    {"key": "background", "label": "Fondo", "type": "color", "default": "#0d1117"},
    {"key": "top", "label": "Ola superior", "type": "bool", "default": true},
    {"key": "middle", "label": "Ola central", "type": "bool", "default": true},
    {"key": "bottom", "label": "Ola inferior", "type": "bool", "default": true},
    {"key": "line_count", "label": "Líneas por ola", "type": "int", "min": 1, "max": 24, "step": 1, "default": 10},
    {"key": "line_distance", "label": "Separación entre líneas", "type": "float", "min": 0.0, "max": 30.0, "step": 0.5, "default": 6.0},
    {"key": "line_style", "label": "Trazo", "type": "enum", "default": "solid",
     "options": [
       {"value": "solid", "label": "Continuo"},
       {"value": "dotted", "label": "Punteado"},
       {"value": "dashed", "label": "Discontinuo"}
     ]},
    {"key": "line_width", "label": "Grosor de línea", "type": "float", "min": 0.25, "max": 6.0, "step": 0.05, "default": 1.0},
    {"key": "glow", "label": "Resplandor", "type": "float", "min": 0.0, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "brightness", "label": "Brillo", "type": "float", "min": 0.1, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "amplitude", "label": "Altura de las olas", "type": "float", "min": 0.0, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "depth_of_field", "label": "Desenfoque de fondo", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.5},
    {"key": "edge_fade", "label": "Desvanecer laterales", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.0},
    {"key": "light_mode", "label": "Modo claro", "type": "bool", "default": false,
     "description": "Líneas de tinta; si el fondo elegido es oscuro se usa blanco."}
  ],
  "notes": "Mismo campo de un solo paso que el original, con la pendiente calculada analíticamente. Sin curvatura ni paralaje del cursor, sin remolino al hacer clic ni intro; el modo de mezcla «screen» se aplica sobre el fondo."
}
