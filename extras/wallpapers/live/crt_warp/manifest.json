{
  "name": "Tubo CRT",
  "component": "CRTWarp",
  "description": "Plasma pixelado en un televisor de tubo: líneas de barrido, máscara de fósforo y cristal curvo.",
  "tags": ["retro", "crt", "plasma", "oscuro"],
  "params": [
    {"key": "color", "label": "Color del fósforo", "type": "color", "default": "#c755f7"},
    {"key": "background", "label": "Fondo del tubo", "type": "color", "default": "#120f17"},
    {"key": "mask", "label": "Máscara de fósforo", "type": "enum", "default": "aperture", "options": [
      {"value": "aperture", "label": "Rejilla de apertura"},
      {"value": "shadow", "label": "Máscara de sombra"},
      {"value": "slot", "label": "Ranuras"},
      {"value": "none", "label": "Ninguna (monocromo)"}
    ]},
    {"key": "variation", "label": "Variación", "type": "int", "min": 0, "max": 50, "step": 1, "default": 0},
    {"key": "wave_amplitude", "label": "Plegado del plasma", "type": "float", "min": 0.05, "max": 1.5, "step": 0.05, "default": 0.3},
    {"key": "wave_frequency", "label": "Frecuencia del plasma", "type": "float", "min": 0.3, "max": 8.0, "step": 0.1, "default": 2.5},
    {"key": "levels", "label": "Niveles de brillo", "type": "int", "min": 2, "max": 12, "step": 1, "default": 3},
    {"key": "columns", "label": "Columnas", "type": "int", "min": 8, "max": 400, "step": 1, "default": 80},
    {"key": "persistence", "label": "Persistencia del fósforo", "type": "float", "min": 0.0, "max": 0.95, "step": 0.05, "default": 0.4},
    {"key": "curvature", "label": "Curvatura del cristal", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.25},
    {"key": "corners", "label": "Esquinas redondeadas", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.0},
    {"key": "scanline_strength", "label": "Intensidad del barrido", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.6},
    {"key": "scanline_frequency", "label": "Líneas de barrido", "type": "float", "min": 20.0, "max": 1200.0, "step": 10.0, "default": 200.0},
    {"key": "mask_strength", "label": "Visibilidad de la máscara", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3},
    {"key": "bloom", "label": "Resplandor", "type": "float", "min": 0.0, "max": 4.0, "step": 0.1, "default": 1.5},
    {"key": "bloom_radius", "label": "Alcance del resplandor", "type": "float", "min": 0.1, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "rgb_shift", "label": "Desajuste RGB", "type": "float", "min": 0.0, "max": 0.012, "step": 0.001, "default": 0.003},
    {"key": "noise", "label": "Grano", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.1},
    {"key": "flicker", "label": "Parpadeo", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.15},
    {"key": "interference", "label": "Interferencias", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.2},
    {"key": "vignette", "label": "Viñeta", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3},
    {"key": "brightness", "label": "Brillo", "type": "float", "min": 0.2, "max": 2.5, "step": 0.05, "default": 1.0},
    {"key": "light_mode", "label": "Modo claro", "type": "bool", "default": false, "description": "Tinta sobre papel; si el fondo es oscuro se usa un papel claro."}
