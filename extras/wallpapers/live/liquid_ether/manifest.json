    {"key": "color_3", "label": "Color rápido", "type": "color", "default": "#b497cf"},
    {"key": "background", "label": "Fondo", "type": "color", "default": "#0d1117"},
    {"key": "intensity", "label": "Intensidad", "type": "float", "min": 0.1, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "cursor_size", "label": "Anchura del removido", "type": "float", "min": 20.0, "max": 400.0, "step": 5.0, "default": 100.0},
    {"key": "persistence", "label": "Persistencia", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.75},
