  "tags": ["geométrico", "minimalista", "oscuro", "monocromo"],
  "params": [
    {"key": "shapes", "label": "Formas", "type": "enum", "default": "mixed", "options": [
      {"value": "mixed", "label": "Mezcladas"},
      {"value": "squares", "label": "Cuadrados"},
      {"value": "circles", "label": "Círculos"},
      {"value": "triangles", "label": "Triángulos"}
    ]},
    {"key": "cell_size", "label": "Tamaño de celda (px)", "type": "float", "min": 4.0, "max": 40.0, "step": 1.0, "default": 10.0},
    {"key": "dot_size", "label": "Tamaño de la forma", "type": "float", "min": 0.1, "max": 1.0, "step": 0.05, "default": 0.75},
    {"key": "color", "label": "Color de las formas", "type": "color", "default": "#929292"},
    {"key": "background", "label": "Fondo", "type": "color", "default": "#000000"},
    {"key": "scale", "label": "Tamaño de las ondas", "type": "float", "min": 0.2, "max": 4.0, "step": 0.05, "default": 1.0},
    {"key": "contrast", "label": "Contraste", "type": "float", "min": 0.0, "max": 3.0, "step": 0.05, "default": 1.0},
    {"key": "brightness", "label": "Brillo", "type": "float", "min": -0.5, "max": 1.5, "step": 0.05, "default": 0.4},
    {"key": "flow", "label": "Deriva (celdas/s)", "type": "float", "min": 0.0, "max": 5.0, "step": 0.1, "default": 0.0},
    {"key": "direction", "label": "Dirección de la deriva (°)", "type": "float", "min": 0.0, "max": 360.0, "step": 1.0, "default": 0.0},
    {"key": "fade", "label": "Desvanecer bordes", "type": "float", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.25},
    {"key": "glow", "label": "Resplandor", "type": "float", "min": 0.0, "max": 1.5, "step": 0.05, "default": 0.35}
