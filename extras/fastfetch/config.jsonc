// The Wonderland greeting: the distro's logo beside a short system summary.
// install.sh copies this directory to ~/.config/fastfetch.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/wonderland.txt",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  // Long values are cut at the window's edge: a line that wraps would land on top of the logo.
  "display": { "separator": "  ", "color": { "keys": "cyan" }, "disableLinewrap": true },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "format": "wonderlandOS ({pretty-name} based)" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "shell", "key": "Shell" },
    {
      "type": "packages",
      "key": "Packages",
      "format": "{?pacman}{pacman} (pacman){?}{?flatpak-all}, {flatpak-all} (flatpak){?}"
    },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "uptime", "key": "Uptime" },
    "break",
    "colors"
  ]
}
