# The compositor under Wonderland's login screen (wonderland-greeter).
# Generated by extras/greeter/scripts/greeter-setup: edit, or run it again.
# Nothing here can be driven by the person at the keyboard: no bindings, no
# canvas navigation, no X11, no session. The only client is the login screen.

autostart = ["@UI@"]

[session]
suspend_on_close = false
restore_windows = false
restore_camera = false
restore_bookmarks = false

[bindings]
disable_defaults = ["keys", "mouse", "gestures", "touch"]

[xwayland]
enabled = false

[background]
# «Rayos de luz» (extras/wallpapers/live/light_rays), rendered at install time.
type = "shader"
path = "@SHADER@"
animate_fps = @FPS@

[output.outline]
thickness = 0

@MACHINE@
