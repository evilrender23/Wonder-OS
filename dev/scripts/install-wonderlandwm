#!/bin/sh
# Install WonderlandWM as a login session (Arch/CachyOS). Run with sudo from
# the repository root after `cargo build --release`:
#
#     sudo dev/scripts/install-wonderlandwm
#
# Installs the runtime tools the rice uses (pacman --needed, so nothing that's
# already there is touched), the compositor into /usr/local/bin, and the
# session entry the display manager lists as "WonderlandWM". The engine still
# answers to `driftwm` (binary, config dir, IPC, systemd unit) — scripts and
# the bar call it by that name — and `wonderlandwm` is a symlink to it.
#
# Undo: sudo dev/scripts/install-wonderlandwm --uninstall
set -eu

[ "$(id -u)" -eq 0 ] || { echo "run it with sudo" >&2; exit 1; }
cd "$(dirname "$0")/../.."
BIN=target/release/driftwm

files="/usr/local/bin/driftwm /usr/local/bin/wonderlandwm /usr/local/bin/driftwm-session
/usr/local/bin/wonderland-secrets /usr/local/share/dbus-1/services/org.freedesktop.secrets.service
/usr/share/wayland-sessions/wonderlandwm.desktop
/usr/share/xdg-desktop-portal/driftwm-portals.conf
/usr/lib/systemd/user/driftwm.service /usr/lib/systemd/user/driftwm-shutdown.target"

if [ "${1:-}" = "--uninstall" ]; then
    for f in $files; do rm -fv "$f"; done
    exit 0
fi

[ -x "$BIN" ] || { echo "$BIN missing: cargo build --release first" >&2; exit 1; }

# libseat (seatd) is what the compositor opens the GPU and input through; the
# rest are the bar's and the keybindings' helpers. The top-level install.sh has
# installed them already and sets WONDERLAND_SKIP_PACKAGES.
if [ -n "${WONDERLAND_SKIP_PACKAGES:-}" ]; then
    :
elif command -v pacman >/dev/null 2>&1; then
    pacman -S --needed --noconfirm \
        seatd xwayland-satellite xdg-desktop-portal-wlr \
        fuzzel swaylock swayidle swayosd brightnessctl playerctl wl-clipboard wlr-randr \
        grim wf-recorder
else
    echo "no pacman: install seatd (libseat), xwayland-satellite and xdg-desktop-portal-wlr yourself" >&2
fi

install -Dm755 "$BIN" /usr/local/bin/driftwm
ln -sf driftwm /usr/local/bin/wonderlandwm
install -Dm755 resources/driftwm-session /usr/local/bin/driftwm-session
install -Dm644 resources/driftwm-portals.conf /usr/share/xdg-desktop-portal/driftwm-portals.conf
# The password store apps look for on D-Bus. In /usr/local so it neither clashes
# with the file gnome-keyring packages nor loses to it.
install -Dm755 resources/wonderland-secrets /usr/local/bin/wonderland-secrets
install -Dm644 resources/org.freedesktop.secrets.service /usr/local/share/dbus-1/services/org.freedesktop.secrets.service
install -Dm644 resources/driftwm.service /usr/lib/systemd/user/driftwm.service
install -Dm644 resources/driftwm-shutdown.target /usr/lib/systemd/user/driftwm-shutdown.target

# DesktopNames stays "driftwm": it becomes XDG_CURRENT_DESKTOP, which picks
# driftwm-portals.conf.
cat > /usr/share/wayland-sessions/wonderlandwm.desktop <<'EOF'
[Desktop Entry]
Name=WonderlandWM
Comment=Infinite-canvas Wayland compositor (driftwm fork)
Exec=/usr/local/bin/driftwm-session
Type=Application
DesktopNames=driftwm
EOF

echo
echo "Installed. Pick \"WonderlandWM\" on the login screen."
if systemctl is-active --quiet 'ly@*' 2>/dev/null || pgrep -x ly-dm >/dev/null; then
    echo "ly reads the session list only when it starts: reboot (or restart ly from a TTY) to see it."
fi
echo "If it misbehaves: Super+Ctrl+Shift+Q quits (or, from a TTY, systemctl --user stop driftwm) and you can pick Plasma again."
