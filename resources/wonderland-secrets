#!/bin/sh
# wonderland-secrets — the session's password store (org.freedesktop.secrets).
# D-Bus starts it the first time an app asks for a saved password: GitHub
# Desktop, VS Code, Chromium, anything built on libsecret. Without a provider
# those apps fail with "The name is not activatable".
#
# KWallet is the one install.sh brings; an older KWallet or GNOME Keyring does
# the same job when that is what the machine has.

if command -v ksecretd >/dev/null 2>&1; then
    exec ksecretd
elif command -v kwalletd6 >/dev/null 2>&1; then
    exec kwalletd6
elif command -v gnome-keyring-daemon >/dev/null 2>&1; then
    exec gnome-keyring-daemon --foreground --components=secrets
fi

echo "wonderland-secrets: no password store installed (kwallet or gnome-keyring)" >&2
exit 1
