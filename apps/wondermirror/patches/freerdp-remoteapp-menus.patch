+/**
+ * The window manager gave the keyboard to a window: have the server make it its
+ * active one, which also raises it there.
+ *
+ * Mouse and keyboard input carry no window, the server sends them to the window
+ * it has on top at that place and to its active one. Without this the two sides
+ * disagree as soon as windows overlap on the server (always, under a Wayland
+ * compositor, which keeps every X window at 0,0): the clicks and keys meant for
+ * the focused window end up in another one.
+ *
+ * Nothing is sent for menus and tooltips, nor when the server already has this
+ * window, or one it owns (an open menu, a dialog), for the active one: an
+ * activation closes the menus of the window that was active before.
+ */
+BOOL xf_rail_focus_window(xfContext* xfc, xfAppWindow* appWindow)
+{
+	WINPR_ASSERT(xfc);
+	WINPR_ASSERT(appWindow);
+
+	if (!xfc->rail || appWindow->is_transient || (appWindow->windowId > UINT32_MAX))
+		return TRUE;
+
+	UINT64 id = xfc->railActiveWindowId;
+	for (int depth = 0; (id != 0) && (depth < 8); depth++)
+	{
+		if (id == appWindow->windowId)
+			return TRUE;
+
+		xfAppWindow* owned = xf_rail_get_window(xfc, id, TRUE);
+		if (!owned)
+			break;
+		id = owned->ownerWindowId;
+		xf_rail_return_window(owned, TRUE);
+	}
+
+	const RAIL_ACTIVATE_ORDER activate = { .windowId = (UINT32)appWindow->windowId,
+		                                   .enabled = TRUE };
+	WLog_Print(xfc->log, WLOG_DEBUG, "activating RAIL window 0x%08" PRIx32 " on focus",
+	           activate.windowId);
+	xfc->railActiveWindowId = appWindow->windowId;
+	return xfc->rail->ClientActivate(xfc->rail, &activate) == CHANNEL_RC_OK;
+}
