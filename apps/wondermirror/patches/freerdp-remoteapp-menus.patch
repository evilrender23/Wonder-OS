+/**
+ * A compositor that draws a menu of its own on a right click the application
+ * left unanswered waits a moment (150 ms, say) for the window to open a menu
+ * or to repaint. The menu of a RemoteApp window comes from the server, a
+ * network round trip and an animation later, so both menus opened, the
+ * compositor's on top. A Windows application always owns its right click:
+ * answer at once by repainting the pixel under the pointer with itself.
+ */
+static void xf_rail_answer_right_click(xfContext* xfc, const XButtonEvent* event)
+{
+	xfAppWindow* appWindow = xf_AppWindowFromX11Window(xfc, event->window);
+
+	if (appWindow && appWindow->gc && (event->x >= 0) && (event->y >= 0))
+	{
+		XCopyArea(xfc->display, appWindow->handle, appWindow->handle, appWindow->gc, event->x,
+		          event->y, 1, 1, event->x, event->y);
+		XFlush(xfc->display);
+	}
+	xf_rail_return_window(appWindow, FALSE);
+}
